# Copy to .env.local for local dev. In production set these in the Render dashboard.
#
# The app code reads the NEXT_PUBLIC_ prefixed names — without the prefix Next.js
# will NOT expose them and the app silently runs unauthenticated ("Local demo").
#
# URL must be the Project URL: https://<project-ref>.supabase.co
# (NOT the https://supabase.com/dashboard/project/<ref> dashboard link).
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Do NOT set PORT on Render — Render injects it and the server binds it automatically.
# Setting PORT here (e.g. 3000) overrides Render's port and causes a 502.
# PORT=3000

# Not used by the running app today (no pg/Prisma). Only needed if you later add a
# direct Postgres client. If so, use the Session Pooler host, never db.<ref>.supabase.co
# (that host is IPv6-only and Render cannot reach it), and keep ?sslmode=require:
# DATABASE_URL=postgresql://postgres.xxxxxxxx:PASSWORD@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
